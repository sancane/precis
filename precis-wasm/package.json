{
  "name": "precis-wasm",
  "version": "0.1.0",
  "description": "WebAssembly bindings for PRECIS Framework profiles (RFC 8264, 8265, 8266)",
  "main": "./precis-node.js",
  "browser": "./precis.js",
  "module": "./precis.js",
  "types": "./precis.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./precis.d.ts",
      "node": "./precis-node.js",
      "browser": "./precis.js",
      "default": "./precis.js"
    },
    "./precis_web.js": "./precis_web.js",
    "./precis_node.js": "./precis_node.js"
  },
  "files": [
    "precis.js",
    "precis.d.ts",
    "precis-node.js",
    "precis-node.d.ts",
    "precis_web.js",
    "precis_web.d.ts",
    "precis_web_bg.wasm",
    "precis_web_bg.wasm.d.ts",
    "precis_node.js",
    "precis_node.d.ts",
    "precis_node_bg.wasm",
    "precis_node_bg.wasm.d.ts"
  ],
  "scripts": {
    "build": "./build.sh",
    "test": "wasm-pack test --headless --chrome"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sancane/precis.git",
    "directory": "precis-wasm"
  },
  "keywords": [
    "precis",
    "rfc8264",
    "rfc8265",
    "rfc8266",
    "nickname",
    "username",
    "password",
    "unicode",
    "normalization",
    "internationalization",
    "wasm",
    "webassembly"
  ],
  "author": "Santiago Carot-Nemesio <sancane@gmail.com>",
  "license": "MIT OR Apache-2.0",
  "bugs": {
    "url": "https://github.com/sancane/precis/issues"
  },
  "homepage": "https://github.com/sancane/precis/tree/main/precis-wasm#readme",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
